# Copia este archivo como .env y llena los valores. El archivo .env NO se sube al repositorio.
# La versión actual (registro de vehículos en memoria) no lee ninguna variable.
# Estas variables se usarán cuando la lógica pase a la API con Laravel, PostgreSQL y JWT.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Clave para firmar los token JWT (el token vence a las 2 horas, RNF-02)
JWT_SECRET=
